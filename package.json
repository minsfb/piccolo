{
  "name": "piccolo",
  "version": "1.20.0",
  "private": true,
  "description": "Experimental Pi configuration and workflows",
  "license": "UNLICENSED",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "piccolo": "./bin/piccolo.mjs"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-env": "1.3.0",
    "pi-extensible-workflows": "5.14.0",
    "smol-toml": "1.8.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "24.13.3",
    "pi-blackhole": "0.5.15",
    "pi-sdk-wake-fixture": "npm:@earendil-works/pi-coding-agent@0.85.1",
    "pi-subagents": "0.79.2",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
